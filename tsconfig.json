{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "lib": ["ESNext", "DOM"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": ["./src/*"]
    },
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "references": [{ "path": "./tsconfig.node.json" }],
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": [
    "src/api/ha-websocket.ts",
    "src/components/AlmanacModal.vue",
    "src/components/WeatherEffects.vue",
    "src/components/settings/CalendarSettings.vue",
    "src/components/settings/SmartHomeSettings.vue",
    "src/components/settings/TestHAConnection.vue",
    "src/stores/ha.ts",
    "src/views/CalendarView.vue",
    "src/views/SmartHomeView.vue"
  ]
}
